{
  "name": "@fortex/api",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end do Fortex (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "admin:promover": "tsx src/scripts/promover-admin.ts"
  },
  "dependencies": {
    "@fortex/db": "workspace:*",
    "@fortex/pricing": "workspace:*",
    "@fortex/validacao": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
