{
  "name": "fortex",
  "private": true,
  "description": "Fortex — intermediadora digital de fretes rodoviários",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
